/POST1
SET,LAST
RSYS,0
*GET,tfin,ACTIVE,0,SET,TIME
ETABLE,SPF,SMISC,1
*DIM,ee,ARRAY,4
ee(1)=1931
ee(2)=1933
ee(3)=1935
ee(4)=1937
*DIM,jn,ARRAY,4
jn(1)=6245
jn(2)=6246
jn(3)=6247
jn(4)=6248
*DIM,sn,ARRAY,5
sn(1)=969
sn(2)=966
sn(3)=723
sn(4)=240
sn(5)=244
*CFOPEN,results,txt
*VWRITE,tfin
('TIME ',F10.5)
*DO,i,1,5
  n_=sn(i)
  *GET,sx,NODE,n_,S,X
  *VWRITE,i,sx
  ('SIG ',F3.0,' ',E16.8)
*ENDDO
*DO,i,1,4
  e_=ee(i)
  n_=jn(i)
  *GET,fv,ELEM,e_,ETAB,SPF
  *GET,ux,NODE,n_,U,X
  *GET,uy,NODE,n_,U,Y
  *VWRITE,i,fv,ux,uy
  ('SPR ',F3.0,' ',E16.8,' ',E16.8,' ',E16.8)
*ENDDO
NSEL,S,LOC,X,-0.01,0.01
*GET,ncount,NODE,0,COUNT
nn=0
rsum=0
*DO,k,1,ncount
  nn=NDNEXT(nn)
  rr=0
  *GET,rr,NODE,nn,RF,FX
  rsum=rsum+rr
*ENDDO
ALLSEL,ALL
*VWRITE,rsum,ncount
('REACT ',E16.8,' ',F6.0)
*CFCLOSE
FINISH
